# ==========================================
# 1. HeadHunter API Credentials
# ==========================================
# Для поиска публичных вакансий ключи не требуются (достаточно User-Agent).
# Для откликов (Module 3) нужны OAuth credentials или Access Token с dev.hh.ru:
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
HH_ACCESS_TOKEN=your_hh_access_token
HH_RESUME_ID=your_resume_id_on_hh
HH_USER_AGENT=JobAgent/1.0 (your_email@example.com)

# ==========================================
# 2. LLM API Keys (для скоринга и писем)
# ==========================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# ==========================================
# 3. Настройки поиска и фильтрации
# ==========================================
SEARCH_TEXT=Python Developer OR Data Engineer
SEARCH_AREA=113 # all - весь мир, ex_ru - мир без РФ, 113 - Россия, 1 - Москва, 2 - СПб
SEARCH_EXPERIENCE=between1And3 # noExperience, between1And3, between3And6, moreThan6
SEARCH_ONLY_WITH_SALARY=false
SEARCH_PER_PAGE=20

# ==========================================
# 4. Telegram Bot (для подтверждения откликов)
# ==========================================
TELEGRAM_BOT_TOKEN=your_tg_bot_token
TELEGRAM_CHAT_ID=your_tg_chat_id
# Опционально: если Telegram API блокируется провайдером
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://127.0.0.1:7890
